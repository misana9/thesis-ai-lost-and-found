# Copy this file to .env on the self-host machine.
FRONTEND_PORT=8080

DATABASE_NAME=lost_and_found
DATABASE_USERNAME=amalost
DATABASE_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# The frontend URL users will open. Change this for a public domain/tunnel.
FRONTEND_BASE_URL=http://localhost:8080

# Optional SMTP. Leave blank to use backend/mail_outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AMAlost <noreply@ama.edu.ph>
SMTP_TLS=true
